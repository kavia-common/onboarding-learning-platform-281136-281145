# Frontend environment variables

# Base URLs (optional for full local-only operation)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=http://localhost:3000

# Feature flags (comma separated or JSON)
REACT_APP_FEATURE_FLAGS=

# Preview mode to show documents only (true/false)
REACT_APP_PREVIEW_DOCUMENTS_ONLY=false

# Supabase configuration (set both to enable Supabase auth; otherwise local-only mode is used)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Deprecated/legacy alias (still recognized; prefer REACT_APP_SUPABASE_KEY)
# REACT_APP_SUPABASE_ANON_KEY=
