# Frontend environment variables for Onboarding LMS

# Backend API base URL (enable server-powered features)
# e.g., http://localhost:4000
REACT_APP_API_BASE=

# Alternate backend URL if needed (usually same as API_BASE)
REACT_APP_BACKEND_URL=

# Frontend site URL (used by some integrations)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional websocket URL
REACT_APP_WS_URL=

# Misc optional settings
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (JSON or comma-separated)
# Example: {"onboarding":true}  OR  onboarding,courses
REACT_APP_FEATURE_FLAGS={"onboarding":true}
REACT_APP_EXPERIMENTS_ENABLED=false

# Preview mode to limit the app to Documents flow only
# When true: only /documents is available; all other routes redirect to /documents
# When false or unset: normal routes are available
REACT_APP_PREVIEW_DOCUMENTS_ONLY=true
