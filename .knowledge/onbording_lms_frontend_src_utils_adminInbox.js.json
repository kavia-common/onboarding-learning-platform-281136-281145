{"is_source_file": true, "format": "JavaScript", "description": "This file provides utility functions for managing an admin inbox stored in localStorage. It includes functions to get, append, clear, and subscribe to updates of inbox items, which are represented as objects containing email, submission date, document flags, and optional PDF data URLs. The code handles SSR guards, JSON parsing errors, and normalizes PDF data URLs before storage.", "external_files": [], "external_methods": [], "published": ["getInboxItems", "appendInboxItem", "clearInbox", "subscribe"], "classes": [], "methods": [{"name": "getInboxItems()", "description": "Returns a list of inbox items from localStorage, resilient to parse errors and SSR.", "scope": "", "scopeKind": ""}, {"name": "appendInboxItem(item)", "description": "Appends a new inbox item to localStorage, normalizing PDF fields into data URLs and maintaining existing data.", "scope": "", "scopeKind": ""}, {"name": "clearInbox()", "description": "Clears the stored inbox data from localStorage.", "scope": "", "scopeKind": ""}, {"name": "subscribe(callback)", "description": "Subscribes to updates for the inbox, including cross-tab storage events and custom events, and returns an unsubscribe function.", "scope": "", "scopeKind": ""}], "calls": ["window.localStorage.getItem", "JSON.parse", "window.localStorage.setItem", "window.dispatchEvent", "window.addEventListener", "window.removeEventListener"], "search-terms": ["admin_inbox_v2", "localStorage-backed inbox", "appendInboxItem", "getInboxItems", "subscribe", "PDF normalization"], "state": 2, "file_id": 84, "knowledge_revision": 444, "git_revision": "a552bdd30a0de0ef3af5bcf62f8800d25bf2ede1", "revision_history": [{"403": ""}, {"420": "df22ca8e478184633380f6bee797c2ccf0c87a5a"}, {"435": "a552bdd30a0de0ef3af5bcf62f8800d25bf2ede1"}, {"444": "a552bdd30a0de0ef3af5bcf62f8800d25bf2ede1"}], "ctags": [{"_type": "tag", "name": "appendInboxItem", "path": "/home/kavia/workspace/code-generation/o